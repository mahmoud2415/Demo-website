# Firebase web app configuration. Do not commit the real .env file.
# These values are entered after creating the Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Cloudinary delivery base can be used when real images replace the demo images.
VITE_CLOUDINARY_CLOUD_NAME=

# Public operations configuration.
VITE_RESTAURANT_WHATSAPP=201020805451
